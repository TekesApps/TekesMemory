{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "user",
            "workspace",
            "thread"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "owner_id"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "replacement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "source_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "host",
          "ref",
          "digest"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    },
    "fact": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "valid_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "valid_to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "subject",
        "predicate",
        "value"
      ],
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "properties": {
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32,
          "minItems": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 64,
          "minItems": 1
        },
        "success_criteria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "verified_environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32,
          "minItems": 0
        }
      },
      "required": [
        "preconditions",
        "steps",
        "success_criteria",
        "verified_environment",
        "failure_modes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scope",
    "idempotency_key",
    "id",
    "expected_revision",
    "replacement",
    "sources"
  ],
  "additionalProperties": false
}
