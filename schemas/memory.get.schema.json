{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "user",
            "workspace",
            "thread"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "owner_id"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "scope",
    "id"
  ],
  "additionalProperties": false
}
